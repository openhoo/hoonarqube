[Unit]
Description=Hoonarqube Jev triage in OpenHoo Cube sandboxes
After=network-online.target tailscaled.service cube-sandbox-cube-api.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/opt/drachen-agent-venv/bin/python /opt/hoonarqube-jev-cube/current/broker.py
LoadCredentialEncrypted=cube-api-key:/etc/hoonarqube-jev-cube/cube-api-key.cred
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
MemoryMax=256M
TasksMax=64
LimitCORE=0

[Install]
WantedBy=multi-user.target
