re.compile(r"a|")
re.compile(r"a||b")
re.compile(r"(|a)")
re.compile(r"(a|)")
re.compile(r"(a||b)")
re.compile(r"(|a)+")
re.compile(r"(a|)+")
re.compile(r"(|a|b)")
re.compile(r"(a|b|)")
re.compile(r"(|a|)")
re.compile(r"(||a)")
re.compile(r"(|)")
re.compile(r"(?:|a)")
re.compile(r"(?:a|)")
re.compile(r"(?=|a)")
re.compile(r"((|a))")
re.compile(r"((?:|a)+)")
re.compile(r"(a)?(?(1)|b)")
re.compile(r"(a)?(?(1)b|)")
re.compile(r"(?:|a)?")
re.compile(r"(?:|a){2}")
re.compile(r"(?:a||b)+")
re.compile(r"(|a|b|c)")
re.compile(r"|")
re.compile(r"||")
