import re

re.compile(r"a(?:^b)")
re.compile(r"a(?:^b|cc)")
re.compile(r"(a$)bc")
re.compile(r"(a$|b)c")
re.compile(r"(a$|)c")
re.compile(r"(a$)?c")
re.compile(r"a(?:x)?^b")
re.compile(r"(?:a|)^b")
re.compile(r"(?:a|b)^b")
re.compile(r"(?:(?=a)|a)^b")
re.compile(r"a(?=^b)")
re.compile(r"(?=a$)b")
re.compile(r"a(?<=^b)")
re.compile(r"a$(?:x|\n)")
re.compile(r"a$(?:x|y)")
re.compile(r"a$(?:\n|x)y")
re.compile(r"a$\n(?=b)")
re.compile(r"a$\t")
re.compile(r"a$\v")
re.compile(r"a$\f")
re.compile(r"a$\x85")
re.compile(r"a$\u2028")
re.compile(r"a$\u2029")
re.compile(r"a$\x0b")
re.compile(r"a$\x0c")
re.compile(r"a$\r?b")
re.compile(r"a$\n\z")
re.compile(r"a$\n\Z")
re.compile(r"(a^)+")
re.compile(r"a(?-i:^b)")
re.compile(r"(?m)(?-m:a^b)")
re.compile(r"(?im)^a$z")
re.compile(r"(?m:ab)c^d")
re.compile(r"\n\Ab")
re.compile(r"\n^b")
re.compile(r"a(?=z)^b")
re.compile(r"a\Z$\nz")
re.compile(r"a$$$$b")
