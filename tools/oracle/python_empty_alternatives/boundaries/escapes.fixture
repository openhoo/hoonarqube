import re

re.compile(r"a$ ")
re.compile(r"a$\ ")
re.compile(r"a$\x20")
re.compile(r"a$\u0020")
re.compile(r"a$\x41")
re.compile(r"a$\u0041")
re.compile(r"a$\101")
re.compile(r"a$\t")
re.compile(r"a$	")
re.compile(r"a$\a")
re.compile(r"a$\x07")
re.compile(r"a$\v")
re.compile(r"a$\x0b")
re.compile(r"a$\b")
re.compile(r"a$\x85")
