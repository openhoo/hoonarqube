import re

re.compile(r"a^b")
re.compile(r"a$b")
re.compile(r"a^b", re.MULTILINE)
re.compile(r"a$b", re.MULTILINE)
re.compile(r"\n^b", re.MULTILINE)
re.compile(r"a$\n", re.MULTILINE)
re.compile(r"a$\s", re.MULTILINE)
re.compile(r"\s^b", re.MULTILINE)
re.compile(r"\n^b")
re.compile(r"a$\n")
re.compile(r"a$\s")
re.compile(r"\s^b")
re.compile(r"(?m)\n^b")
re.compile(r"(?m:a$\n)b")
re.compile(r"a\Z\s", re.MULTILINE)
re.compile(r"\s\Ab", re.MULTILINE)
re.compile(r"[a-z]+$z")
re.compile(r"zz[^\n]^z", re.M)
re.compile(r"a$.b", re.M | re.S)
re.compile(r"a$[\s\S]c", re.M)
re.compile(r"^a$", re.M)
re.compile(r"(?:|a)")
re.compile(r"(?:a|)")
re.compile(r"(?:a||b)")
re.compile(r"(?(1)|b)")
